<?xml version="1.0" encoding="UTF-8"?>
<plugin version="1">
  <name> Route Toolbar </name>
  <version> @VERSION@ </version>
  <release> 0 </release>
  <summary> Route-aware coastal passage planning and pilotage tools </summary>

  <api-version> 1.21 </api-version>
  <open-source> yes </open-source>
  <author> Ulf Andreasson </author>
  <source> https://github.com/UlfAndreasson/opencpn-route-toolbar </source>
  <info-url> https://github.com/UlfAndreasson/opencpn-route-toolbar </info-url>

  <description>
    Route-aware EBL/VRM, parallel indexing,
    turn geometry, leg course/distance labels,
    Route Objects and passage-plan reports.
    OpenCPN remains the owner of routes and
    waypoints.
  </description>

  <target>ubuntu-gtk3-x86_64</target>
  <build-target>ubuntu</build-target>
  <build-gtk>gtk3</build-gtk>
  <target-version>24.04</target-version>
  <target-arch>x86_64</target-arch>
</plugin>
